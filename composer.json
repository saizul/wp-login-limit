{
    "name": "saizul/wp-login-limit",
    "description": "Login Limit: brute-force protection for WordPress. Limits failed logins per IP and per username with escalating lockouts on wp-login.php, XML-RPC and REST application passwords, with trusted proxies, CIDR allow/deny lists, fail2ban log lines and WP-CLI.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "security",
        "brute-force",
        "login",
        "lockout",
        "fail2ban",
        "xmlrpc",
        "wp-cli"
    ],
    "homepage": "https://github.com/saizul/wp-login-limit",
    "authors": [
        {
            "name": "Saizul Amin",
            "homepage": "https://saizul.com"
        }
    ],
    "support": {
        "issues": "https://github.com/saizul/wp-login-limit/issues",
        "source": "https://github.com/saizul/wp-login-limit"
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Saizul\\LoginLimit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saizul\\LoginLimit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "make-pot": "php bin/make-pot.php"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "7.4.33"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
