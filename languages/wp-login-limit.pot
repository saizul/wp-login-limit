#. Plugin URI of the plugin
#: wp-login-limit.php
msgid "https://github.com/saizul/wp-login-limit"
msgstr ""

#. Description of the plugin
#: wp-login-limit.php
msgid "Brute-force protection without upsells: limits failed logins per IP and per username with escalating lockouts on wp-login.php, XML-RPC and REST application passwords. Trusted proxies, CIDR allow/deny lists, lockout log, throttled email alerts, fail2ban log lines and WP-CLI."
msgstr ""

#. Author of the plugin
#: wp-login-limit.php
msgid "Saizul Amin"
msgstr ""

#. Author URI of the plugin
#: wp-login-limit.php
msgid "https://saizul.com"
msgstr ""

